include "application.conf"

grpc {
  server {
    host = "127.0.0.1"
    host = ${?GRPC_HOST}

    port = 3031
    port = ${?GRPC_PORT}
  }
}

pekko {
  loglevel = "DEBUG"
  loglevel = ${?LOG_LEVEL}
}
